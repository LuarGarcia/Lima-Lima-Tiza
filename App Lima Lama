// Ejercicios de la semana para martes y jueves. Edítalos aquí cada semana.
const PHYSICAL_TRAINING = {
  desc: 'Complemento aparte del reto de técnica. Súmalo dos veces por semana.',
  exercises: [
    '3 series de 10 lagartijas',
    '3 series de 10 abdominales',
    '3 series de 10 burpees',
    '30 a 45 min de trotar o correr',
  ],
};

const NEXT_EVENT = null;
const LAST_KEY = 'lima-lama-last-name';
const DAYS = [['LUN','Lunes'],['MAR','Martes'],['MIÉ','Miércoles'],['JUE','Jueves'],['VIE','Viernes']];
let STUDENT = '';
let calDays = [];

const store = {
  async get(k){
    try{ if(window.storage) return await window.storage.get(k); }catch(e){}
    try{ const v = localStorage.getItem(k); return v ? { value: v } : null; }catch(e){ return null; }
  },
  async set(k, v){
    try{ if(window.storage){ await window.storage.set(k, v); return; } }catch(e){}
    try{ localStorage.setItem(k, v); }catch(e){}
  }
};

function renderChallenge(){
  document.getElementById('weekBadge').textContent = CURRENT_WEEK.label;
  document.getElementById('challengeTitle').textContent = CURRENT_WEEK.title;
  document.getElementById('challengeDesc').textContent = CURRENT_WEEK.desc;
  document.getElementById('challengeReps').textContent = CURRENT_WEEK.reps;

  const durWrap = document.getElementById('challengeDurationWrap');
  if(CURRENT_WEEK.duration){
    document.getElementById('challengeDuration').textContent = CURRENT_WEEK.duration;
    durWrap.style.display = '';
  } else {
    durWrap.style.display = 'none';
  }

  const fig = document.getElementById('techniqueFigure');
  const link = document.getElementById('techniqueLink');
  const note = document.getElementById('techniqueNote');
  if(CURRENT_WEEK.figure && FIGURES[CURRENT_WEEK.figure]){
    fig.innerHTML = FIGURES[CURRENT_WEEK.figure];
    link.style.display = 'none';
    note.textContent = 'Postura de referencia. Si tienes dudas, pregúntale a tu profe.';
  } else if(CURRENT_WEEK.videoUrl){
    fig.innerHTML = '';
    link.href = CURRENT_WEEK.videoUrl;
    link.style.display = 'inline-flex';
    note.textContent = 'Se abre en una pestaña nueva.';
  } else {
    fig.innerHTML = '';
    link.style.display = 'none';
    note.textContent = 'El video está en camino. Mientras tanto, pregúntale a tu profe cómo va la técnica.';
  }
}

function renderPhysical(){
  document.getElementById('physDesc').textContent = PHYSICAL_TRAINING.desc;
  const list = document.getElementById('physList');
  list.innerHTML = '';
  PHYSICAL_TRAINING.exercises.forEach(ex => {
    const li = document.createElement('li');
    li.textContent = ex;
    list.appendChild(li);
  });
}

const calKey = () => `cal:${CURRENT_WEEK.id}:${STUDENT}`;

async function loadCal(){
  try{
    const r = await store.get(calKey());
    const a = r ? JSON.parse(r.value) : [];
    calDays = Array.isArray(a) ? a.filter(n => Number.isInteger(n) && n >= 0 && n < 5) : [];
  }catch(e){ calDays = []; }
}

function renderCal(){
  const grid = document.getElementById('weekGrid');
  grid.innerHTML = '';
  DAYS.forEach(([abbr, full], i) => {
    const on = calDays.includes(i);
    const b = document.createElement('button');
    b.type = 'button';
    b.className = 'day' + (on ? ' on' : '');
    b.setAttribute('aria-pressed', on ? 'true' : 'false');
    b.setAttribute('aria-label', full + (on ? ', entrenado' : ', sin marcar'));
    b.innerHTML = `<span>${abbr}</span><span class="day-check" aria-hidden="true">✓</span>`;
    b.addEventListener('click', async () => {
      calDays = on ? calDays.filter(d => d !== i) : [...calDays, i].sort();
      await store.set(calKey(), JSON.stringify(calDays));
      renderCal();
    });
    grid.appendChild(b);
  });
  const n = calDays.length;
  document.getElementById('weekCount').textContent = n === 0
    ? 'Aún no marcas ningún día esta semana. Mínimo: 2 días.'
    : `${n} día${n === 1 ? '' : 's'} entrenado${n === 1 ? '' : 's'} esta semana` + (n >= 2 ? ' · ¡meta mínima cumplida! 💪' : ' · mínimo: 2 días');
}

function cleanName(v){
  return v.replace(/[^A-Za-zÁÉÍÓÚÜÑáéíóúüñ]/g, '').toUpperCase().slice(0, 10);
}

async function enterApp(name){
  STUDENT = name;
  try{ localStorage.setItem(LAST_KEY, name); }catch(e){}
  document.getElementById('welcomeName').textContent = name;
  await loadCal();
  renderCal();
  document.getElementById('loginView').hidden = true;
  document.getElementById('appView').hidden = false;
  window.scrollTo(0, 0);
}

function showLogin(){
  document.getElementById('appView').hidden = true;
  document.getElementById('loginView').hidden = false;
  const input = document.getElementById('studentName');
  input.value = STUDENT;
  window.scrollTo(0, 0);
  input.focus();
}

function renderNextEvent(){
  const titleEl = document.getElementById('eventTitle');
  const dateEl = document.getElementById('eventDate');
  if(NEXT_EVENT){
    titleEl.textContent = NEXT_EVENT.title;
    dateEl.textContent = NEXT_EVENT.date;
  } else {
    titleEl.textContent = 'Sin eventos próximos';
    dateEl.textContent = '';
  }
}

(function initNavPills(){
  document.querySelectorAll('.nav-pill').forEach(pill => {
    pill.addEventListener('click', () => {
      const target = document.getElementById(pill.dataset.target);
      if(target) target.scrollIntoView({ behavior: 'smooth', block: 'start' });
    });
  });
})();

(function init(){
  renderChallenge();
  renderPhysical();
  renderNextEvent();

  const input = document.getElementById('studentName');
  const err = document.getElementById('loginError');
  try{ input.value = cleanName(localStorage.getItem(LAST_KEY) || ''); }catch(e){}

  input.addEventListener('input', () => { input.value = cleanName(input.value); err.textContent = ''; });
  document.getElementById('loginForm').addEventListener('submit', (e) => {
    e.preventDefault();
    const name = cleanName(input.value);
    if(!name){ err.textContent = 'Escribe el nombre del alumno para ingresar.'; input.focus(); return; }
    enterApp(name);
  });
  document.getElementById('switchStudent').addEventListener('click', showLogin);
})();
</script>
