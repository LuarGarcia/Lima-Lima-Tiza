<!DOCTYPE html>
<html lang="es">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Lima Lama Tizayuca</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link href="https://fonts.googleapis.com/css2?family=Oswald:wght@500;600;700&family=Work+Sans:wght@400;500;600&display=swap" rel="stylesheet">
<style>
  :root{
    --mat: #1B2430;
    --mat-deep: #141B25;
    --card: #232D3D;
    --card-line: #34405420;
    --line: #3A465A;
    --amber: #E8A33D;
    --ember: #C1443B;
    --jade: #4F9D8D;
    --paper: #F0EBE1;
    --paper-dim: #B9BFC9;
  }
  *{box-sizing:border-box;}
  body{
    margin:0;
    background: var(--mat);
    background-image:
      radial-gradient(circle at 15% 0%, #26314420 0%, transparent 45%),
      radial-gradient(circle at 85% 100%, #26314420 0%, transparent 45%);
    color: var(--paper);
    font-family: 'Work Sans', sans-serif;
    min-height:100vh;
    padding-bottom: 48px;
  }
  .wrap{ max-width: 560px; margin: 0 auto; padding: 0 18px; }

  html{ scroll-behavior: smooth; }
  section{ scroll-margin-top: 18px; }
  a, button, input, [tabindex]{ }
  a:focus-visible, button:focus-visible, input:focus-visible{
    outline: 2px solid var(--amber);
    outline-offset: 2px;
  }
  header{
    padding: 28px 18px 16px;
    text-align:center;
    border-bottom: 1px solid var(--line);
    margin-bottom: 24px;
  }
  .nav-pills{
    display:flex;
    justify-content:center;
    gap: 6px;
    overflow-x: auto;
    padding: 16px 2px 0;
    margin: 0 -2px;
    scrollbar-width: none;
  }
  .nav-pills::-webkit-scrollbar{ display:none; }
  .nav-pill{
    flex-shrink:0;
    font-family:'Oswald', sans-serif;
    font-size: 11px;
    letter-spacing: 1px;
    text-transform: uppercase;
    text-decoration: none;
    color: var(--paper-dim);
    background: var(--card);
    border: 1px solid var(--line);
    border-radius: 20px;
    padding: 8px 11px;
    white-space: nowrap;
    cursor: pointer;
  }
  .brand{
    font-family:'Oswald', sans-serif;
    font-weight:700;
    font-size: 24px;
    letter-spacing: 2px;
    text-transform: uppercase;
    color: var(--paper);
    margin: 0;
  }
  .brand span{ color: var(--amber); }
  .tagline{
    font-size: 12px;
    letter-spacing: 2px;
    text-transform: uppercase;
    color: var(--paper-dim);
    margin-top: 6px;
  }

  .eyebrow{
    font-family:'Oswald', sans-serif;
    font-size: 12px;
    letter-spacing: 2.5px;
    text-transform: uppercase;
    color: var(--amber);
    margin: 0 0 10px 2px;
  }

  .challenge-card{
    background: linear-gradient(155deg, var(--card), var(--mat-deep));
    border: 1px solid var(--line);
    border-radius: 14px;
    padding: 22px;
    margin-bottom: 30px;
    position: relative;
    overflow: hidden;
  }
  .challenge-card::before{
    content: '';
    position: absolute;
    top: -40%; right: -20%;
    width: 220px; height: 220px;
    background: radial-gradient(circle, #E8A33D14, transparent 70%);
  }
  .week-badge{
    display:inline-block;
    font-family:'Oswald', sans-serif;
    font-size: 11px;
    letter-spacing: 1.5px;
    text-transform: uppercase;
    background: var(--amber);
    color: var(--mat-deep);
    padding: 4px 10px;
    border-radius: 4px;
    font-weight: 600;
    margin-bottom: 12px;
  }
  .challenge-title{
    font-family:'Oswald', sans-serif;
    font-size: 24px;
    font-weight: 600;
    margin: 0 0 10px;
    line-height: 1.2;
  }
  .challenge-desc{
    color: var(--paper-dim);
    font-size: 15px;
    line-height: 1.55;
    margin: 0 0 18px;
  }
  .technique-cta{
    border: 1px solid var(--line);
    border-radius: 10px;
    background: var(--mat-deep);
    padding: 16px;
    margin-bottom: 16px;
    text-align: center;
  }
  .btn-technique{
    display:inline-flex;
    align-items:center;
    gap: 10px;
    font-family:'Oswald', sans-serif;
    letter-spacing: 1px;
    text-transform: uppercase;
    font-size: 14px;
    font-weight: 600;
    background: var(--amber);
    color: var(--mat-deep);
    border-radius: 8px;
    padding: 13px 20px;
    text-decoration: none;
    transition: transform .1s ease;
  }
  .btn-technique:active{ transform: scale(0.98); }
  .btn-technique-icon{ font-size: 12px; }
  .technique-note{
    margin: 10px 0 0;
    font-size: 12px;
    color: var(--paper-dim);
    line-height: 1.5;
  }

  .challenge-meta{
    display:flex;
    gap: 18px;
    font-size: 13px;
    color: var(--paper-dim);
    border-top: 1px solid var(--line);
    padding-top: 14px;
  }
  .challenge-meta b{ color: var(--paper); font-weight: 600;}

  .mark-section{
    background: var(--card);
    border: 1px solid var(--line);
    border-radius: 14px;
    padding: 20px;
    margin-bottom: 30px;
  }
  select{
    width: 100%;
    background: var(--mat-deep);
    color: var(--paper);
    border: 1px solid var(--line);
    border-radius: 8px;
    padding: 12px 14px;
    font-size: 15px;
    font-family: 'Work Sans', sans-serif;
    margin-bottom: 12px;
    appearance: none;
  }
  .row{ display:flex; gap:10px; }
  button{
    font-family:'Oswald', sans-serif;
    letter-spacing: 1px;
    text-transform: uppercase;
    font-size: 14px;
    font-weight: 600;
    border: none;
    border-radius: 8px;
    padding: 13px 16px;
    cursor: pointer;
    flex: 1;
    transition: transform .1s ease, opacity .15s ease;
  }
  button:active{ transform: scale(0.98); }
  .btn-complete{ background: var(--jade); color: #0F1E1B; }
  .btn-undo{ background: transparent; color: var(--paper-dim); border: 1px solid var(--line); }
  .status-line{
    margin-top: 12px;
    font-size: 13px;
    color: var(--paper-dim);
    min-height: 18px;
  }
  .status-line.done{ color: var(--jade); }

  .ranking-list{ list-style:none; margin:0; padding:0; }
  .rank-item{
    display:flex;
    align-items:center;
    gap: 14px;
    padding: 13px 16px;
    background: var(--card);
    border: 1px solid var(--line);
    border-radius: 10px;
    margin-bottom: 8px;
  }
  .rank-pos{
    font-family:'Oswald', sans-serif;
    font-weight:700;
    font-size: 15px;
    width: 26px;
    text-align:center;
    color: var(--paper-dim);
  }
  .rank-item.top1 .rank-pos{ color: var(--amber); }
  .rank-item.top2 .rank-pos{ color: #C9CDD4; }
  .rank-item.top3 .rank-pos{ color: #C48A5C; }
  .rank-name{ flex:1; font-size: 15px; font-weight: 500; }
  .belt-strip{
    flex-shrink: 0;
    width: 46px;
    height: 10px;
    border-radius: 5px;
    background: repeating-linear-gradient(45deg, #ffffff18 0 4px, transparent 4px 8px), var(--amber);
    position: relative;
  }
  .rank-item:not(.top1):not(.top2):not(.top3) .belt-strip{ background: var(--line); }
  .rank-count{
    font-family:'Oswald', sans-serif;
    font-size: 13px;
    color: var(--paper-dim);
    width: 54px;
    text-align:right;
  }
  .empty{
    text-align:center;
    color: var(--paper-dim);
    font-size: 14px;
    padding: 20px;
  }
  .ranking-summary{
    font-size: 13px;
    color: var(--paper-dim);
    margin: 0 2px 12px;
    line-height: 1.5;
  }

  .cal-card{
    display:flex;
    align-items:center;
    justify-content: space-between;
    gap: 14px;
    background: linear-gradient(155deg, #2A1E1C, var(--card));
    border: 1px solid var(--line);
    border-radius: 14px;
    padding: 18px 20px;
    margin-bottom: 10px;
  }
  .cal-text b{ display:block; font-size: 15px; margin-bottom: 3px; }
  .cal-text span{ font-size: 13px; color: var(--paper-dim); }
  .cal-btn{
    flex-shrink:0;
    background: var(--ember);
    color: var(--paper);
    text-decoration: none;
    font-family:'Oswald', sans-serif;
    font-size: 13px;
    letter-spacing: 1px;
    text-transform: uppercase;
    padding: 10px 14px;
    border-radius: 8px;
    font-weight: 600;
  }

  .dash-header{
    display:flex;
    align-items:center;
    padding: 0 14px;
    margin-bottom: 8px;
  }
  .dash-header-name{ flex:1; font-size: 11px; color: var(--paper-dim); letter-spacing: 1px; text-transform: uppercase; }
  .dash-header-col{
    width: 58px;
    text-align:center;
    font-size: 11px;
    color: var(--paper-dim);
    letter-spacing: 0.5px;
    text-transform: uppercase;
  }
  .dash-list{ list-style:none; margin:0; padding:0; }
  .dash-row{
    display:flex;
    flex-direction: column;
    gap: 10px;
    background: var(--card);
    border: 1px solid var(--line);
    border-radius: 10px;
    padding: 12px 14px;
    margin-bottom: 8px;
  }
  .dash-row-top{
    display:flex;
    align-items:center;
    gap: 8px;
  }
  .dash-name{
    flex: 1;
    font-family:'Oswald', sans-serif;
    font-weight: 600;
    font-size: 15px;
    letter-spacing: 0.5px;
    word-break: break-word;
  }
  .dash-streak{
    font-size: 12px;
    color: var(--amber);
    white-space: nowrap;
  }
  .dash-remove{
    flex: 0 0 auto;
    width: 28px;
    height: 28px;
    padding: 0;
    display:flex;
    align-items:center;
    justify-content:center;
    background: transparent;
    border: 1px solid var(--line);
    color: var(--paper-dim);
    border-radius: 50%;
    font-size: 15px;
    line-height: 1;
  }
  .dash-remove:active{ transform: scale(0.9); }
  .dash-goal-row{
    display:flex;
    flex-direction: column;
    gap: 10px;
  }
  .dash-goal{
    width:100%;
    background: var(--mat-deep);
    border: 1px solid var(--line);
    border-radius: 8px;
    padding: 8px 12px;
    cursor: pointer;
    text-align: left;
    transition: transform .1s ease;
  }
  .dash-goal:active{ transform: scale(0.98); }
  .dash-goal-top{
    display:flex;
    justify-content: space-between;
    align-items: baseline;
    margin-bottom: 6px;
  }
  .dash-goal-label{
    font-family:'Oswald', sans-serif;
    font-size: 11px;
    letter-spacing: 0.5px;
    text-transform: uppercase;
    color: var(--paper-dim);
  }
  .dash-goal-count{
    font-family:'Oswald', sans-serif;
    font-size: 12px;
    font-weight: 600;
    color: var(--paper-dim);
  }
  .dash-goal-bar{
    height: 8px;
    background: rgba(255,255,255,0.08);
    border-radius: 5px;
    overflow: hidden;
  }
  .dash-goal-fill{
    height: 100%;
    border-radius: 5px;
    background: var(--line);
    transition: width .2s ease, background .2s ease;
  }
  .dash-goal.partial .dash-goal-fill{ background: var(--amber); }
  .dash-goal.partial .dash-goal-count{ color: var(--amber); }
  .dash-goal.complete .dash-goal-fill{ background: var(--jade); }
  .dash-goal.complete .dash-goal-count{ color: var(--jade); }
  .dash-empty{
    text-align:center;
    color: var(--paper-dim);
    font-size: 14px;
    padding: 16px;
  }

  .add-student{
    display:flex;
    gap:8px;
    margin-top: 14px;
  }
  .add-student input{
    flex:1;
    background: var(--mat-deep);
    border: 1px solid var(--line);
    color: var(--paper);
    border-radius: 8px;
    padding: 10px 12px;
    font-size: 14px;
    font-family:'Work Sans', sans-serif;
  }
  .add-student button{
    flex: 0 0 auto;
    background: transparent;
    border: 1px solid var(--line);
    color: var(--amber);
    padding: 10px 16px;
  }

  .physical-card{ padding: 20px; }
  .phys-list{
    list-style:none;
    counter-reset: phys-counter;
    margin:0; padding:0;
    display:flex;
    flex-direction:column;
    gap: 8px;
  }
  .phys-list li{
    counter-increment: phys-counter;
    display:flex;
    align-items:center;
    gap: 10px;
    font-size: 14px;
    color: var(--paper);
    background: var(--mat-deep);
    border: 1px solid var(--line);
    border-radius: 8px;
    padding: 10px 14px;
  }
  .phys-list li::before{
    content: counter(phys-counter);
    width: 20px; height: 20px;
    border-radius: 50%;
    background: var(--amber);
    color: var(--mat-deep);
    font-family: 'Oswald', sans-serif;
    font-weight: 600;
    font-size: 11px;
    display:flex;
    align-items:center;
    justify-content:center;
    flex-shrink: 0;
  }

  section{ margin-bottom: 34px; }
  .disclaimer{
    display:flex;
    gap: 10px;
    align-items:flex-start;
    text-align:left;
    margin-top: 16px;
    padding: 12px 14px;
    border-radius: 8px;
    border: 1px solid rgba(193,68,59,0.4);
    background: rgba(193,68,59,0.08);
  }
  .disclaimer-icon{ font-size: 16px; line-height: 1.4; flex-shrink:0; }
  .disclaimer-text{
    margin:0;
    font-size: 12px;
    color: var(--paper-dim);
    line-height: 1.6;
  }
  .disclaimer-text b{ color: var(--paper); }
  .rest-tip{
    display:flex;
    gap: 10px;
    align-items:flex-start;
    text-align:left;
    margin-top: 14px;
    padding: 12px 14px;
    border-radius: 8px;
    border: 1px solid var(--line);
    background: var(--mat-deep);
  }
  .rest-tip-icon{ font-size: 16px; line-height: 1.4; flex-shrink:0; }
  .rest-tip-text{
    margin:0;
    font-size: 12px;
    color: var(--paper-dim);
    line-height: 1.6;
  }
  .rest-tip-text b{ color: var(--paper); }
  .note{
    font-size: 12px;
    color: var(--paper-dim);
    text-align:center;
    margin-top: 26px;
    line-height: 1.6;
  }

  [hidden]{ display:none !important; }
  .login{ min-height:100vh; display:flex; flex-direction:column; align-items:center; justify-content:center; padding:32px 24px; text-align:center; gap:30px; }
  .login-brand{ font-family:'Oswald',sans-serif; font-weight:700; font-size:34px; letter-spacing:3px; line-height:1.2; margin:0; text-transform:uppercase; }
  .login-brand span{ color:var(--amber); display:block; font-size:44px; letter-spacing:5px; }
  .login-form{ width:100%; max-width:320px; display:flex; flex-direction:column; gap:12px; }
  .login-label{ font-family:'Oswald',sans-serif; font-size:12px; letter-spacing:1.5px; text-transform:uppercase; color:var(--paper-dim); }
  .login-input{ width:100%; height:54px; text-align:center; text-transform:uppercase; letter-spacing:4px; font-family:'Oswald',sans-serif; font-size:22px; color:var(--paper); background:var(--mat-deep); border:1px solid var(--line); border-radius:10px; }
  .login-input::placeholder{ color:#6b7687; letter-spacing:3px; }
  .login-btn{ height:52px; border:0; border-radius:10px; background:var(--amber); color:var(--mat-deep); font-family:'Oswald',sans-serif; font-weight:600; font-size:16px; letter-spacing:2px; text-transform:uppercase; cursor:pointer; }
  .login-btn:active{ transform:scale(0.98); }
  .login-error{ margin:0; min-height:18px; font-size:13px; color:#E98B83; }
  .welcome{ margin:12px 0 0; font-size:18px; color:var(--paper-dim); }
  .welcome-name{ font-family:'Oswald',sans-serif; font-weight:700; font-size:26px; letter-spacing:3px; color:#FFD27A; margin-left:4px; text-shadow:0 0 8px rgba(232,163,61,.9),0 0 22px rgba(232,163,61,.5); animation:glow 2.4s ease-in-out infinite alternate; }
  @keyframes glow{ from{ text-shadow:0 0 5px rgba(232,163,61,.6),0 0 12px rgba(232,163,61,.3);} to{ text-shadow:0 0 10px rgba(232,163,61,1),0 0 26px rgba(232,163,61,.65);} }
  @media (prefers-reduced-motion: reduce){ .welcome-name{ animation:none; } }
  .switch-student{ margin-top:12px; background:none; border:0; color:var(--paper-dim); font-size:12px; text-decoration:underline; cursor:pointer; padding:6px; }
  .week-hint{ margin:0 2px 12px; font-size:13px; color:var(--paper-dim); line-height:1.5; }
  .week-grid{ display:grid; grid-template-columns:repeat(5,1fr); gap:8px; }
  .day{ display:flex; flex-direction:column; align-items:center; gap:10px; padding:12px 0 14px; background:var(--card); border:1px solid var(--line); border-radius:10px; color:var(--paper-dim); font-family:'Oswald',sans-serif; font-size:12px; letter-spacing:1px; cursor:pointer; transition:transform .1s ease; }
  .day:active{ transform:scale(0.95); }
  .day-check{ width:32px; height:32px; border-radius:50%; border:2px solid var(--line); display:flex; align-items:center; justify-content:center; font-size:17px; color:transparent; }
  .day.on{ border-color:var(--jade); color:var(--paper); }
  .day.on .day-check{ background:var(--jade); border-color:var(--jade); color:#0F1E1B; }
  .week-count{ margin:12px 2px 0; font-size:13px; color:var(--paper-dim); text-align:center; }
</style>
</head>
<body>
<main class="login" id="loginView">
  <h1 class="login-brand"><span>TIGERS</span>LIMA LAMA TIZAYUCA</h1>
  <form class="login-form" id="loginForm" novalidate>
    <label class="login-label" for="studentName">Introducir nombre del alumno</label>
    <input class="login-input" id="studentName" type="text" maxlength="10" autocomplete="off" autocapitalize="characters" spellcheck="false" placeholder="NOMBRE">
    <p class="login-error" id="loginError" role="alert"></p>
    <button class="login-btn" type="submit">Ingresar</button>
  </form>
</main>

<div class="wrap" id="appView" hidden>

  <header>
    <p class="brand">LIMA <span>LAMA</span> TIZAYUCA</p>
    <p class="welcome">Bienvenido <span class="welcome-name" id="welcomeName"></span></p>
    <p class="tagline">Entrenamiento entre semana</p>
    <nav class="nav-pills" aria-label="Ir a sección">
      <button type="button" class="nav-pill" data-target="reto">Reto</button>
      <button type="button" class="nav-pill" data-target="fisico">Físico</button>
      <button type="button" class="nav-pill" data-target="semana">Mi semana</button>
      <button type="button" class="nav-pill" data-target="evento">Evento</button>
    </nav>
    <button type="button" class="switch-student" id="switchStudent">Cambiar alumno</button>
  </header>

  <section id="reto">
    <p class="eyebrow">Reto de esta semana</p>
    <div class="challenge-card">
      <span class="week-badge" id="weekBadge">Semana —</span>
      <h2 class="challenge-title" id="challengeTitle">Cargando…</h2>

      <div class="technique-cta" id="techniqueCta">
        <div id="techniqueFigure"></div>
        <a class="btn-technique" id="techniqueLink" href="#" target="_blank" rel="noopener">
          <span class="btn-technique-icon">▶</span>
          <span>Ver la técnica en video</span>
        </a>
        <p class="technique-note" id="techniqueNote"></p>
      </div>

      <p class="challenge-desc" id="challengeDesc"></p>
      <div class="challenge-meta">
        <div id="challengeDurationWrap"><b id="challengeDuration">—</b> min/día</div>
        <div><b id="challengeReps">—</b> repeticiones</div>
        <div><b>2</b> veces/semana mínimo</div>
      </div>
    </div>
  </section>

  <section id="fisico">
    <p class="eyebrow">Entrenamiento físico · martes y jueves</p>
    <div class="challenge-card physical-card">
      <p class="challenge-desc" id="physDesc" style="margin-bottom:14px;"></p>
      <ol class="phys-list" id="physList"></ol>
      <div class="rest-tip">
        <span class="rest-tip-icon">⏱️</span>
        <p class="rest-tip-text"><b>Descanso de 1 a 2 minutos entre cada serie.</b> No intento hacer todo seguido — el descanso es parte del entrenamiento.</p>
      </div>
      <div class="disclaimer">
        <span class="disclaimer-icon">⚠️</span>
        <p class="disclaimer-text">
          <b>Ajusto los ejercicios a mi capacidad.</b> Caliento mínimo 5 minutos antes de empezar.
          <b>Si soy menor de 10 años, entreno siempre con la supervisión de un adulto.</b>
          <b>No salgo a correr o caminar solo</b> — siempre voy acompañado de un adulto. Si no puedo salir, lo compenso con 2 series más de burpees.
        </p>
      </div>
    </div>
  </section>

  <section id="semana">
    <p class="eyebrow">Mi semana de entrenamiento</p>
    <p class="week-hint">Toca el día que entrenaste para marcarlo con ✓.</p>
    <div class="week-grid" id="weekGrid"></div>
    <p class="week-count" id="weekCount"></p>
  </section>

  <section id="evento">
    <p class="eyebrow">Eventos próximos</p>
    <div class="cal-card">
      <div class="cal-text">
        <b id="eventTitle">Sin eventos próximos</b>
        <span id="eventDate"></span>
      </div>
    </div>
  </section>


  <p class="note">Prototipo · Lima Lama — retos semanales para practicar en casa entre clases.</p>
</div>

<script>
// Pega aquí el link del video (YouTube "no listado" o Google Drive compartido).
// Si lo dejas vacío, la app muestra un aviso en vez del botón.
const WEEKS = [
  { id: 'sem1', start: '1970-01-01', label: 'Semana 1', title: 'Forma de posiciones básicas', desc: 'Con lo visto en clase, practica la forma de posiciones básicas en casa después de terminar los ejercicios de abajo. Repítela de 3 a 9 veces.', duration: null, reps: '3 a 9', figure: 'stance' },
];
function pickWeek(){
  const forced = WEEKS.find(w => '#' + w.id === location.hash);
  if(forced) return forced;
  const d = new Date();
  const today = d.getFullYear() + '-' + String(d.getMonth()+1).padStart(2,'0') + '-' + String(d.getDate()).padStart(2,'0');
  let cur = WEEKS[0];
  WEEKS.forEach(w => { if(w.start <= today) cur = w; });
  return cur;
}
const CURRENT_WEEK = pickWeek();

